# Copy to .env and fill in real values. .env is gitignored, this file is not.

# Audius app credentials.
# Server-only: Nuxt maps these to runtimeConfig.audiusKey / runtimeConfig.audiusSecret.
# Server routes read them with useRuntimeConfig(event); they are never exposed to the browser.
NUXT_AUDIUS_KEY=
NUXT_AUDIUS_SECRET=
